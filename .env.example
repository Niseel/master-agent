# Copy to .env (gitignored). Values here override agenthub.config.ts.

# mock | byok | copilot
AGENTHUB_RUNTIME=mock
# AGENTHUB_MODEL=claude-sonnet-4.5
# AGENTHUB_MAX_AI_CREDITS=120   # min 30 per agent session
# AGENTHUB_TIMEOUT_MS=150000
# AGENTHUB_LOG_DIR=          # audit log dir, default logs/ (pnpm test uses a temp dir)
# Mock runtime only: fixtures/scenarios/<name>.jsonl
# AGENTHUB_SCENARIO=brief-ok

# Azure DevOps
ADO_ORG=
ADO_PROJECT=
# Optional: separate `az` profile for the ADO account when it differs from the Azure account.
# Sign in once: $env:AZURE_CONFIG_DIR="$HOME\.azure-ado"; az login --allow-no-subscriptions
# ADO_AZURE_CONFIG_DIR=C:\Users\<you>\.azure-ado

# GitHub: comma-separated owner/repo list. Empty = every repo you take part in.
# Full URLs also work (https://github.com/owner/repo[.git]); they are normalized to owner/repo.
GITHUB_REPOS=
# Token for the GitHub remote MCP server (read-only header is always set).
# Get one with: gh auth token
GITHUB_MCP_TOKEN=

# Azure Monitor (Work only; uses `az login`)
AZURE_SUBSCRIPTION=
AZURE_LOG_WORKSPACE=

# BYOK at Home only. Empty = use your personal Copilot login instead.
ANTHROPIC_API_KEY=
# BYOK_BASE_URL=https://api.anthropic.com
